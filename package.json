{
  "name": "fruitulator",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "version": "0.0.1",
  "description": "Web-based fruit machine emulator",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "build:wasm": "node tools/build-wasm-coldfire.mjs && node tools/build-wasm-m68k.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "assemblyscript": "^0.28.20",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "1.63.0",
    "puppeteer": "^25.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.186.1"
  }
}
